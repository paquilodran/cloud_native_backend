{
  "info": {
    "name": "Pedidos360 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "access_token", "value": "" },
    { "key": "token_sin_scope", "value": "" }
  ],
  "item": [
    {
      "name": "1. Health (público) → 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/public/health"
      }
    },
    {
      "name": "2. GET pedidos SIN token → 401 Unauthorized",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/pedidos"
      }
    },
    {
      "name": "3. GET pedidos token inválido → 401 Unauthorized",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer token-invalido" }
        ],
        "url": "{{baseUrl}}/api/pedidos"
      }
    },
    {
      "name": "4. GET pedidos token SIN scope access_as_user → 403 Forbidden",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token_sin_scope}}" }
        ],
        "url": "{{baseUrl}}/api/pedidos"
      }
    },
    {
      "name": "5. GET pedidos CON token válido → 200 OK",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": "{{baseUrl}}/api/pedidos"
      }
    },
    {
      "name": "6. POST pedido CON token válido → 201 Created",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Pedido demo Postman\",\n  \"cliente\": \"Cliente QA\",\n  \"estado\": \"CREADO\",\n  \"total\": 9900.00\n}"
        },
        "url": "{{baseUrl}}/api/pedidos"
      }
    }
  ]
}
