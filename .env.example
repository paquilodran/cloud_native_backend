# Copiar a .env (no subir a GitHub) o exportar en la terminal.
# En Windows PowerShell: $env:AZURE_TENANT_ID="..."

AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_API_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_API_APP_ID_URI=api://00000000-0000-0000-0000-000000000000

# Perfil postgres (docker compose up -d)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pedidos360_db
DB_USERNAME=pedidos
DB_PASSWORD=pedidos

CORS_ALLOWED_ORIGINS=http://localhost:4200
